#!/usr/bin/env bash
# Install ClineFlow without replacing user-owned agent instructions or knowledge.
set -euo pipefail

VERSION="2.1.0"
BASE_URL="${CLINEFLOW_BASE_URL:-https://raw.githubusercontent.com/hassanvfx/clineflow/main/template}"
FORCE=false
DRY_RUN=false
ASSUME_YES=false

usage() {
  cat <<'EOF'
Usage: curl -fsSL https://raw.githubusercontent.com/hassanvfx/clineflow/main/template/.clineflow/bin/install | bash [--] [options]

Options:
  --dry-run  Show the managed files that would be installed.
  --force    Refresh ClineFlow-owned files in .clineflow/ only.
  --yes      Approve the detected prerequisite installation without prompting.
  --help     Show this help.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=true ;;
    --force) FORCE=true ;;
    --yes) ASSUME_YES=true ;;
    --help|-h) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

fetch() {
  local source=$1 destination=$2
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$BASE_URL/$source" -o "$destination"
  elif command -v wget >/dev/null 2>&1; then wget -q "$BASE_URL/$source" -O "$destination"
  else echo "WARNING: no downloader is available to fetch $source" >&2; return 1; fi
}

install_managed() {
  local source=$1 destination=$2
  if [ -e "$destination" ] && [ "$FORCE" = false ]; then
    echo "preserved managed file: $destination"
    return
  fi
  mkdir -p "$(dirname "$destination")"
  if ! fetch "$source" "$destination"; then echo "WARNING: could not install $destination; preserved installation progress" >&2; return 0; fi
  case "$destination" in */bin/*) chmod +x "$destination" ;; esac
  echo "installed: $destination"
}

install_fixture() {
  local source=$1 destination=$2
  if [ -e "$destination" ]; then echo "preserved user fixture: $destination"; return 0; fi
  mkdir -p "$(dirname "$destination")"
  if ! fetch "$source" "$destination"; then rm -f "$destination"; echo "WARNING: could not install fixture $destination" >&2; return 0; fi
  echo "installed fixture: $destination"
}

BEGIN='<!-- BEGIN CLINEFLOW OKF RULES -->'
END='<!-- END CLINEFLOW OKF RULES -->'
record_owned_agent() { grep -qxF "$1" .clineflow/.owned-agent-files 2>/dev/null || printf '%s\n' "$1" >> .clineflow/.owned-agent-files; }

block_status() {
  local destination=$1 begins ends
  begins=$(grep -cFx "$BEGIN" "$destination" 2>/dev/null || true)
  ends=$(grep -cFx "$END" "$destination" 2>/dev/null || true)
  if [ "$begins" -eq 0 ] && [ "$ends" -eq 0 ]; then echo none
  elif [ "$begins" -eq 1 ] && [ "$ends" -eq 1 ] && [ "$(grep -nFx "$BEGIN" "$destination" | cut -d: -f1)" -lt "$(grep -nFx "$END" "$destination" | cut -d: -f1)" ]; then echo valid
  else echo malformed; fi
}

write_block() {
  local rules
  rules=$(mktemp)
  if ! fetch "configs/rules.template.md" "$rules"; then rm -f "$rules"; return 1; fi
  printf '%s\n' "$BEGIN"
  cat "$rules"
  printf '\n%s\n' "$END"
  rm -f "$rules"
}

install_agent() {
  local destination=$1 status temp
  mkdir -p "$(dirname "$destination")"
  if [ ! -e "$destination" ]; then
    if write_block > "$destination"; then record_owned_agent "file:$destination"; echo "installed agent configuration: $destination"
    else rm -f "$destination"; echo "WARNING: could not create $destination; preserved installation progress" >&2; fi
    return
  fi
  status=$(block_status "$destination")
  if [ "$status" = malformed ]; then echo "WARNING: malformed ClineFlow markers; preserved $destination" >&2; return; fi
  if [ "$status" = none ]; then
    if { printf '\n'; write_block; } >> "$destination"; then record_owned_agent "block:$destination"; echo "merged ClineFlow rules into: $destination"
    else echo "WARNING: could not merge ClineFlow rules into $destination; preserved installation progress" >&2; fi
    return
  fi
  temp=$(mktemp)
  local begin_line end_line
  begin_line=$(grep -nFx "$BEGIN" "$destination" | cut -d: -f1)
  end_line=$(grep -nFx "$END" "$destination" | cut -d: -f1)
  head -n $((begin_line - 1)) "$destination" > "$temp"
  if ! write_block >> "$temp"; then rm -f "$temp"; echo "WARNING: could not refresh ClineFlow rules in $destination; preserved installation progress" >&2; return; fi
  tail -n +$((end_line + 1)) "$destination" >> "$temp"
  mv "$temp" "$destination"
  record_owned_agent "block:$destination"
  echo "refreshed ClineFlow rules in: $destination"
}

migrate_legacy_runtime() {
  [ -d clineflow ] || return 0
  for file in JOURNAL_TEMPLATE.md PROCEDURES.md WORKING_WITH_CLINE.md WORKING_WITH_CODEX.md; do
    source="clineflow/$file" destination=".clineflow/$file"
    [ -f "$source" ] || continue
    if [ -e "$destination" ]; then echo "WARNING: legacy $source preserved; destination exists at $destination" >&2
    else mv "$source" "$destination"; echo "migrated legacy runtime file: $source"; fi
  done
  if [ -z "$(find clineflow -mindepth 1 -maxdepth 1 -print -quit)" ]; then rmdir clineflow; else echo "WARNING: legacy clineflow/ retained with unrecognized content" >&2; fi
}

load_prerequisites() {
  local script_path="${BASH_SOURCE[0]:-}" script_dir module temp
  if [ -n "$script_path" ] && [ -f "$script_path" ]; then
    script_dir=$(cd "$(dirname "$script_path")" && pwd)
    module="$script_dir/prereqs"
  elif [ -f .clineflow/bin/prereqs ]; then
    module=.clineflow/bin/prereqs
  fi
  if [ -n "${module:-}" ] && [ -f "$module" ]; then . "$module"; return 0; fi
  temp=$(mktemp) || return 1
  if fetch ".clineflow/bin/prereqs" "$temp"; then . "$temp"; rm -f "$temp"; return 0; fi
  rm -f "$temp"
  return 1
}

if load_prerequisites; then clineflow_prereq_run "$DRY_RUN" "$ASSUME_YES" || true
else echo "WARNING: prerequisite preflight unavailable; continuing with ClineFlow installation." >&2; fi

ensure_git_repository() {
  if ! command -v git >/dev/null 2>&1; then
    echo "WARNING: Git is unavailable; ClineFlow cannot initialize this repository." >&2
    return 0
  fi
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Git repository already available."
    return 0
  fi
  if [ "$DRY_RUN" = true ]; then
    echo "Would initialize a Git repository in: $(pwd)"
    return 0
  fi
  if ! git init -q; then
    echo "WARNING: Git is available but repository initialization failed; ClineFlow installation will continue." >&2
    return 0
  fi
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Initialized Git repository in: $(pwd)"
  else
    echo "WARNING: Git initialization did not create a usable work tree; ClineFlow installation will continue." >&2
  fi
}

ensure_git_repository

if [ "$DRY_RUN" = true ]; then
  cat <<'EOF'
Would install ClineFlow tooling under .clineflow/ and merge one managed rules block into native agent configurations.
Would also create missing durable-development fixtures in knowledge/ and docs/.
Would initialize Git when this directory is not already a Git work tree and Git is available.
Existing content outside ClineFlow markers, knowledge files, and documentation fixtures is never overwritten, including with --force.
EOF
  exit 0
fi

mkdir -p .clineflow/bin knowledge/journals docs
[ -e .clineflow/.owned-agent-files ] || : > .clineflow/.owned-agent-files
migrate_legacy_runtime
install_agent .clinerules
install_agent AGENTS.md
install_agent CLAUDE.md
install_agent .github/copilot-instructions.md
install_agent .windsurf/rules/clineflow.md

for file in JOURNAL_TEMPLATE.md PROCEDURES.md WORKING_WITH_CLINE.md WORKING_WITH_CODEX.md VERSION; do
  install_managed ".clineflow/$file" ".clineflow/$file"
done
for file in install update uninstall validate-okf doctor prereqs bootstrap.ps1; do
  install_managed ".clineflow/bin/$file" ".clineflow/bin/$file"
done
for file in index.md log.md journals/index.md journals/TASK_TEMPLATE.md; do
  if [ -e "knowledge/$file" ]; then echo "preserved user knowledge: knowledge/$file"; else install_managed "knowledge/$file" "knowledge/$file"; fi
done
for file in clineflow_specification.yml clineflow_verification.yml clineflow_goals.yml clineflow_last_session.yml clineflow_timeline.yml; do
  install_fixture "knowledge/$file" "knowledge/$file"
done
install_fixture "docs/durable-development-methodology.md" "docs/durable-development-methodology.md"

echo "ClineFlow $VERSION installed. Read docs/durable-development-methodology.md, then verify with: ./.clineflow/bin/doctor"
